PORT=8787

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# eBay Direkt-Posting: für den nächsten Integrationsschritt
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=

# eBay OAuth / Sell APIs
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_DE

# Öffentlich erreichbare HTTPS-Basisadresse des Backends.
# Beispiel: https://verkaufsassistent.example.de
# Daraus ergibt sich die Accept URL:
# https://verkaufsassistent.example.de/ebay/oauth/callback
PUBLIC_BASE_URL=

OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# eBay Notification API / V19 Push
# 32–80 Zeichen, nur A-Z a-z 0-9 _ -
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
# Optional persistenter Pfad für Expo Push Tokens
PUSH_TOKEN_STORE_PATH=./data/push-tokens.json
# Privater Pairing-Code für App ↔ Backend (mindestens 8 Zeichen).
# Nicht in den App-Quellcode einbauen; einmal in der App eingeben.
PUSH_PAIRING_CODE=
